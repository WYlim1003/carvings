{
  "version": 2,
  "env": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY"
  ],
  "functions": {
    "index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node@3.x"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}